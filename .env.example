# Variables de entorno para Suite de Soporte Innovex
PYTHONPATH=.

# ──────────────────────────────────────────────
# Configuración de Correo Electrónico (SMTP IONOS)
# ──────────────────────────────────────────────
# Backend de correo:
# - Para enviar correos reales por SMTP: django.core.mail.backends.smtp.EmailBackend
# - Para guardar correos en archivos locales (carpeta correos_prueba/): django.core.mail.backends.filebased.EmailBackend
# - Para imprimir correos por consola: django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Servidor SMTP de IONOS (1&1)
EMAIL_HOST=smtp.1und1.de
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Credenciales de acceso de la casilla de correo emisor (ej: soporte@innovex.cl)
EMAIL_HOST_USER=tu_correo@innovex.cl
EMAIL_HOST_PASSWORD=tu_contraseña_aqui
